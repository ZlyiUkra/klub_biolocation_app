---
// The pictures block of the panel's forms (T143 of specs/001-self-hosted-club-site, 2026-10-12, at the owner's word):
// upload a picture from the computer or paste the address of one from the internet, put it into the text where the
// cursor is, and copy the address of one that is already uploaded. Used by the posts form and the videos form; the
// script is src/scripts/admin-images.ts and it works on the textarea the editor last had the cursor in
// (`#admin-body`, and `#admin-members-only` on the videos page).
//
// Decisions that would otherwise look like mistakes:
// - This block is not a form of its own and must not become one: it stands inside the editor form, and a nested form
//   is invalid HTML. The script keeps Enter in the address field from saving the post.
// - Uploaded pictures cannot be deleted from here (the owner's rule: bytes are removed by the owner, never by a save).
import { adminUi } from "../i18n/admin";
import { langAttrs } from "../i18n/lang";
import T from "./T.astro";

// The same class lists as the pages' own; Tailwind reads them here like any other class.
const field =
  "w-full rounded border border-gray-300 bg-[#ffffff] p-2.5 text-sm text-gray-800 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:focus:border-blue-500 dark:focus:ring-blue-500";
const label = "mb-1 block text-sm text-gray-500 dark:text-slate-400";
const secondary =
  "rounded border border-gray-300 px-4 py-2 text-sm text-gray-700 transition-opacity hover:opacity-80 disabled:opacity-50 dark:border-slate-600 dark:text-gray-200";
---

<details
  id="admin-images"
  class="rounded border border-gray-300 p-3 dark:border-slate-700"
>
  <summary class="cursor-pointer text-sm font-medium">
    <T s={adminUi.img_heading} />
  </summary>
  <div class="mt-3 space-y-4">
    <p id="admin-images-help" class="text-xs text-gray-500 dark:text-slate-400">
    </p>

    <div class="space-y-2">
      <label for="admin-image-file" class={label}>
        <T s={adminUi.img_file} />
      </label>
      <input
        id="admin-image-file"
        type="file"
        accept="image/png,image/jpeg,image/webp,image/gif"
        class="text-sm"
      />
      <div class="flex flex-wrap items-center gap-3">
        <button id="admin-image-upload" type="button" class={secondary}>
          <T s={adminUi.img_upload} />
        </button>
        <progress
          id="admin-image-progress"
          class="h-2 w-40"
          max="100"
          value="0"
          hidden></progress>
      </div>
      <p id="admin-image-status" class="text-sm" role="status"></p>
    </div>

    <div class="space-y-2">
      <label for="admin-image-url" class={label}>
        <T s={adminUi.img_url_label} />
      </label>
      <input
        id="admin-image-url"
        type="text"
        class={field}
        autocomplete="off"
        spellcheck="false"
        {...langAttrs({ placeholder: adminUi.img_url_ph })}
      />
      <button id="admin-image-url-insert" type="button" class={secondary}>
        <T s={adminUi.img_url_insert} />
      </button>
      <p class="text-xs text-gray-500 dark:text-slate-400">
        <T s={adminUi.img_url_help} />
      </p>
      <p id="admin-image-url-error" class="text-xs text-red-600" hidden></p>
    </div>

    <div class="space-y-2">
      <p class={label}><T s={adminUi.img_list} /></p>
      <p id="admin-image-none" class="text-sm" hidden>
        <T s={adminUi.img_none} />
      </p>
      <ul id="admin-image-list" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      </ul>
      <button id="admin-image-more" type="button" class={secondary} hidden>
        <T s={adminUi.img_more} />
      </button>
    </div>
  </div>
</details>

<template id="admin-image-item">
  <li
    class="flex gap-3 rounded border border-gray-200 p-2 dark:border-slate-700"
  >
    <img
      data-thumb
      alt=""
      loading="lazy"
      class="h-16 w-16 flex-none rounded bg-gray-100 object-cover dark:bg-slate-800"
    />
    <div class="min-w-0 flex-1 space-y-1">
      <p data-name class="truncate text-sm"></p>
      <p data-size class="text-xs text-gray-500 dark:text-slate-400"></p>
      <div class="flex flex-wrap gap-2">
        <button data-insert type="button" class={secondary}>
          <T s={adminUi.img_insert} />
        </button>
        <button data-copy type="button" class={secondary}>
          <T s={adminUi.img_copy} />
        </button>
      </div>
    </div>
  </li>
</template>

<script>
  import "../scripts/admin-images";
</script>
