---
// One labelled field of the account forms (T053 of specs/001-self-hosted-club-site). The classes are those of the
// feedback form's inputs (ContactModal.astro), so a field looks the same in both themes and nothing new is added to
// the stylesheet; `ym-disable-keys` keeps Yandex Metrika's session replay from recording what is typed (T145).
//
// `toggle` adds the show/hide control of a password field: a button over the right end of the input with two icons,
// the open eye (the password is visible) and the crossed eye (it is hidden), wired by bindPasswordToggles() in
// src/scripts/auth-forms.ts. The icons are toggled with the `hidden` class, never the attribute, which does nothing
// on an inline SVG (CLAUDE.md). The label is a real `label for`, so a click on it focuses the field and a screen
// reader names it.
// Changed 2026-10-12 (T178): label and hint are Phrases (src/i18n/lang.ts), printed through T, and the show/hide
// button's label is in both languages (langAttrs).
import type { Phrase } from "../i18n/lang";
import { langAttrs } from "../i18n/lang";
import { ui } from "../i18n/strings";
import T from "./T.astro";

interface Props {
  id: string;
  name: string;
  label: Phrase;
  type?: "text" | "email" | "password";
  autocomplete?: string;
  required?: boolean;
  minlength?: number;
  maxlength?: number;
  hint?: Phrase;
  toggle?: boolean;
  // Added 2026-10-11 (T146): the text a field starts with, for the profile form of the account page.
  value?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  autocomplete,
  required = false,
  minlength,
  maxlength,
  hint,
  toggle = false,
  value,
} = Astro.props;
const inputClass =
  "ym-disable-keys w-full rounded border border-gray-300 bg-[#ffffff] p-2.5 text-sm text-gray-800 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-gray-200 dark:focus:border-blue-500 dark:focus:ring-blue-500";
---

<div>
  <label for={id} class="mb-1 block text-sm text-gray-500 dark:text-slate-400"
    ><T s={label} /></label
  >
  <div class="relative">
    <input
      id={id}
      name={name}
      type={type}
      autocomplete={autocomplete}
      required={required}
      minlength={minlength}
      maxlength={maxlength}
      value={value}
      aria-describedby={hint ? `${id}-hint` : undefined}
      class:list={[inputClass, toggle && "pr-11"]}
    />
    {
      toggle && (
        <button
          type="button"
          data-password-toggle={id}
          {...langAttrs({ "aria-label": ui.form_password_show })}
          aria-pressed="false"
          class="absolute inset-y-0 right-0 flex items-center px-3 text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-gray-200"
        >
          <svg
            data-icon-hidden
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
            />
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
            />
          </svg>
          <svg
            data-icon-shown
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="hidden h-5 w-5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88"
            />
          </svg>
        </button>
      )
    }
  </div>
  {
    hint && (
      <p
        id={`${id}-hint`}
        class="mt-1 text-xs text-gray-500 dark:text-slate-400"
      >
        <T s={hint} />
      </p>
    )
  }
  <p
    data-field-error={id}
    class="mt-1 hidden text-xs text-red-600 dark:text-red-400"
  >
  </p>
</div>
